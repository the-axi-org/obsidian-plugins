{
  "name": "obsidian-plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter \"./plugins/*\" build",
    "typecheck": "tsc -p . && pnpm --filter \"./plugins/*\" typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm --filter \"./plugins/*\" lint",
    "format": "prettier --write .",
    "new": "node scripts/new-plugin.mjs",
    "rename": "node scripts/rename-plugin.mjs",
    "version-bump": "node scripts/version-bump.mjs",
    "vault:setup": "node scripts/setup-vault.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "happy-dom": "^21.0.3",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
